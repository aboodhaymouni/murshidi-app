# Copy to .env.local and fill in. .env.local is gitignored — never commit a real key.

# Optional HTTPS origin for live public-data refresh in packaged mobile builds.
# The service must expose GET /api/public-data and allow the app origin via CORS.
VITE_PUBLIC_DATA_API_URL=https://data.example.jo

# ── Academic advisor (OpenRouter) ─────────────────────────────────────────────
# Without a key the advisor still works: it falls back to the rule-based offline
# layer, which answers from src/data/majors.ts with no network at all.
#
# Create a key at https://openrouter.ai/keys and cap its credit limit. The app
# bundles whatever value is set here into the client build, so use a capped key.
VITE_OPENROUTER_KEY=

# First model in the fallback chain. Leave blank for the app default.
# Chain (src/lib/ai/config.ts), tried in order:
#   1. google/gemma-4-31b-it:free       free, shares the upstream provider pool
#   2. google/gemma-4-26b-a4b-it:free   free, same pool
#   3. google/gemma-4-31b-it            paid, used only when both free tiers fail
#   4. rule-based local answer          no network required
VITE_OPENROUTER_MODEL=google/gemma-4-31b-it:free

# Sent as the HTTP-Referer header so the traffic is attributable on the
# OpenRouter dashboard. Use the deployed origin of the app.
VITE_OPENROUTER_REFERER=https://example.github.io/murshidi-app/
